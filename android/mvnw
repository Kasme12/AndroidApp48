#!/usr/bin/env bash
# Maven wrapper script for Photos48 Android project

set -e

MAVEN_VERSION="3.9.5"
MAVEN_HOME="${HOME}/.m2/wrapper/maven-${MAVEN_VERSION}"

# Check if Maven wrapper is installed
if [ ! -d "${MAVEN_HOME}" ]; then
    echo "Installing Maven ${MAVEN_VERSION}..."
    mkdir -p "${MAVEN_HOME}"
    
    MAVEN_URL="https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz"
    
    curl -fsSL "${MAVEN_URL}" | tar xz -C "${MAVEN_HOME}" --strip-components=1
    echo "Maven ${MAVEN_VERSION} installed successfully"
fi

# Execute Maven with provided arguments
"${MAVEN_HOME}/bin/mvn" "$@"
